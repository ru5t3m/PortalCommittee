meta {
  name: Список пользователей
  type: http
  seq: 36
}

get {
  url: {{base_url}}/api/v1/admin/users?limit=100&offset=0
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_token}}
}

script:pre-request {
  for (const name of ["admin_token"]) {
    if (!bru.getVar(name)) throw new Error("Заполните переменную: " + name);
  }
}
