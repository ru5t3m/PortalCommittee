meta {
  name: Назначить территориальные права
  type: http
  seq: 37
}

patch {
  url: {{base_url}}/api/v1/admin/users/{{user_id}}/access
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_token}}
  Content-Type: application/json
}

body:json {
  {
    "role": "moderator",
    "staff_scope": "territorial",
    "organizational_unit_id": {{organizational_unit_id}}
  }
}

script:pre-request {
  if (String(bru.getEnvVar("allow_writes")) !== "true") throw new Error("Для изменения данных задайте allow_writes=true.");
  for (const name of ["admin_token","user_id","organizational_unit_id"]) {
    if (!bru.getVar(name)) throw new Error("Заполните переменную: " + name);
  }
}
