meta {
  name: Создать тестовое подразделение
  type: http
  seq: 39
}

post {
  url: {{base_url}}/api/v1/admin/organizational-units
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_token}}
  Content-Type: application/json
}

body:json {
  {
    "code": "test-unit",
    "name_ru": "Тестовое подразделение",
    "name_kk": "Сынақ бөлімшесі"
  }
}

script:pre-request {
  if (String(bru.getEnvVar("allow_writes")) !== "true") throw new Error("Для изменения данных задайте allow_writes=true.");
  for (const name of ["admin_token"]) {
    if (!bru.getVar(name)) throw new Error("Заполните переменную: " + name);
  }
}
