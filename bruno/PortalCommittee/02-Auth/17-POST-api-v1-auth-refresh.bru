meta {
  name: Обновление сессии
  type: http
  seq: 17
}

post {
  url: {{base_url}}/api/v1/auth/refresh
  body: none
  auth: none
}

script:pre-request {
  if (String(bru.getEnvVar("allow_writes")) !== "true") {
    throw new Error("Этот запрос изменяет данные. Для тестирования явно задайте allow_writes=true в выбранном окружении.");
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar("access_token", res.getBody().access_token);
  }
}

docs {
  POST /api/v1/auth/refresh

  Токен пользователя не требуется.
  Запрос запускается вручную после включения allow_writes=true. Используйте тестовые данные.
  Используется refresh-cookie из успешного входа. Bruno должен сохранять cookies между запросами.
}
