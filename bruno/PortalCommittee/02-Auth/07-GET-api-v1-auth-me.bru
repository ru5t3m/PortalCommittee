meta {
  name: Текущий пользователь
  type: http
  seq: 7
}

get {
  url: {{base_url}}/api/v1/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

script:pre-request {
  for (const name of ["access_token"]) {
    if (!bru.getVar(name)) throw new Error("Заполните переменную: " + name);
  }
}

docs {
  GET /api/v1/auth/me

  Нужен токен пользователя (access_token).
}
