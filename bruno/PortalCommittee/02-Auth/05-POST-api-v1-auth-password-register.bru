meta {
  name: Регистрация тестового пользователя
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/auth/password/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "first_name": "Тест",
    "last_name": "Проверка",
    "birth_date": "2000-01-01",
    "phone": "+70000000000",
    "personal_data_consent": true,
    "consent_locale": "ru"
  }
}

script:pre-request {
  if (String(bru.getEnvVar("allow_writes")) !== "true") {
    throw new Error("Этот запрос изменяет данные. Для тестирования явно задайте allow_writes=true в выбранном окружении.");
  }
  for (const name of ["email","password"]) {
    if (!bru.getVar(name)) throw new Error("Заполните переменную: " + name);
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar("access_token", res.getBody().access_token);
  }
}

docs {
  POST /api/v1/auth/password/register

  Токен пользователя не требуется.
  Запрос запускается вручную после включения allow_writes=true. Используйте тестовые данные.
  personal_data_consent=true подтверждает согласие тестового пользователя на сбор, обработку и хранение персональных данных.
}
