meta {
  name: GET /api/v1/psychological-tests/progress/{test_slug}
  type: http
  seq: 19
}

get {
  url: {{base_url}}/api/v1/psychological-tests/progress/{{test_slug}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

script:pre-request {
  for (const name of ["test_slug","access_token"]) {
    if (!bru.getVar(name)) throw new Error("Заполните переменную: " + name);
  }
}

docs {
  GET /api/v1/psychological-tests/progress/{test_slug}

  Нужен токен пользователя (access_token).
}
